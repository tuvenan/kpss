# Supabase Yapılandırması
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Geliştirme ve Demo Modu Bayrağı
# Yalnızca yerel geliştirmede (import.meta.env.DEV) demo oturum ve sahte ödeme akışlarını açmak için 'true' yapın.
# Production build'lerde güvenlik nedeniyle her zaman false kalmalıdır.
VITE_ENABLE_DEMO_MODE=false

# ÖNEMLİ GÜVENLİK NOTU:
# SUPABASE_SERVICE_ROLE_KEY veya herhangi bir service role anahtarı bu dosyaya veya
# VITE_ önekli bir environment değişkenine KESİNLİKLE eklenmemelidir.
# Service role anahtarları yalnızca sunucu tarafında (Edge Functions, backend) kullanılır.
