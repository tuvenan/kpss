# Supabase Yapılandırması
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Geliştirme ve Demo Modu Bayrağı
# Yalnızca yerel geliştirmede (import.meta.env.DEV) demo oturum ve sahte ödeme akışlarını açmak için 'true' yapın.
# Production build'lerde güvenlik nedeniyle her zaman false kalmalıdır.
VITE_ENABLE_DEMO_MODE=false
